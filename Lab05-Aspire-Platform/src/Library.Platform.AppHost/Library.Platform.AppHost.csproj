<Project Sdk="Microsoft.NET.Sdk">

  <!-- AppHost на Aspire 17.x вимагає .NET 10 SDK і цільовий net10.0.
       Усі ПРИКЛАДНІ проєкти платформи залишаються на net9.0 за методичкою:
       Aspire оркеструє проєкти будь-якої версії, бо запускає їх як окремі
       процеси, а не завантажує їхні збірки. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>library-platform-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="17.0.0" />
  </ItemGroup>

</Project>
