{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    }
  },

  "//": [
    "Маршрути (Routes) та кластери (Clusters) YARP.",
    "Адреси кластерів — ЛОГІЧНІ імена ресурсів AppHost (http://lending-api),",
    "а не localhost:port: реальну адресу підставляє service discovery Aspire",
    "через AddServiceDiscoveryDestinationResolver().",
    "",
    "УВАГА — колізія шляхів. Сервіс Видач (Лаб. 02) має власну локальну",
    "проєкцію довідника книг на /api/books, і такий самий шлях має Каталог",
    "(Лаб. 03). Канонічним джерелом даних про книги є Каталог, тому",
    "/api/books веде в catalog-api, а проєкція сервісу Видач доступна через",
    "/api/lending/books (префікс знімається трансформацією PathRemovePrefix).",
    "",
    "Order: менше число = вищий пріоритет. Специфічніші маршрути",
    "(/api/lending/books, /api/aggregator) мають бути вище за загальні."
  ],

  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },

      "lending-books": {
        "ClusterId": "lending",
        "Order": 2,
        "Match": { "Path": "/api/lending/books/{**catch-all}" },
        "//": "PathPattern переписує шлях ПОВНІСТЮ: /api/lending/books/1 -> /api/books/1. PathRemovePrefix тут не підходить — він дав би /books/1 без префікса /api.",
        "Transforms": [ { "PathPattern": "/api/books/{**catch-all}" } ],
        "Metadata": { "Team": "lending", "Version": "v1" }
      },

      "loans": {
        "ClusterId": "lending",
        "Order": 5,
        "Match": { "Path": "/api/loans/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "lending", "Version": "v1" }
      },
      "readers": {
        "ClusterId": "lending",
        "Order": 5,
        "Match": { "Path": "/api/readers/{**catch-all}" },
        "Metadata": { "Team": "lending", "Version": "v1" }
      },

      "books": {
        "ClusterId": "catalog",
        "Order": 5,
        "Match": { "Path": "/api/books/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "authors": {
        "ClusterId": "catalog",
        "Order": 5,
        "Match": { "Path": "/api/authors/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "genres": {
        "ClusterId": "catalog",
        "Order": 5,
        "Match": { "Path": "/api/genres/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },

      "reviews": {
        "ClusterId": "reviews",
        "Order": 5,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "discussions": {
        "ClusterId": "reviews",
        "Order": 5,
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      }
    },

    "Clusters": {
      "aggregator": {
        "Destinations": { "d1": { "Address": "http://aggregator" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "lending": {
        "Destinations": { "d1": { "Address": "http://lending-api" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "catalog": {
        "Destinations": { "d1": { "Address": "http://catalog-api" } },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "reviews": {
        "Destinations": { "d1": { "Address": "http://reviews-api" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      }
    }
  }
}
