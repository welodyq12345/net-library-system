<Project Sdk="Microsoft.NET.Sdk">

  <!-- AppHost на Aspire 17.x вимагає .NET 10 SDK і цільовий net10.0.
       Усі ПРИКЛАДНІ проєкти рішення залишаються на net9.0 за методичкою
       (Aspire орхеструє проєкти будь-якої версії). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>library-lending-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library.Lending.Api\Library.Lending.Api.csproj" />
  </ItemGroup>

</Project>
